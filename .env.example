# Supabase project URL (Dashboard > Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public client key used by the browser SDK.
# In recent Supabase UI this may be labeled "Publishable key"; this project expects it in NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Secret server-side key (never expose in the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
